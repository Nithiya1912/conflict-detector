# Copy to backend/.env and adjust.
ENVIRONMENT=development
# SQLite by default. For PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/cicd (pip install "psycopg[binary]")
DATABASE_URL=sqlite:///./cicd.db

# REQUIRED outside development: a long random string (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=dev-only-change-me-please-0123456789abcdef
ACCESS_TOKEN_MINUTES=120
COOKIE_SECURE=false

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seeds synthetic cases, demo accounts and the synthetic evidence corpus.
DEMO_MODE=true

# Optional generative layer. "none" = deterministic rules + KG + retrieval only.
LLM_PROVIDER=none
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-opus-5-5

RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.08
LOG_LEVEL=INFO
